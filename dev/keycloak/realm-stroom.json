{
  "realm": "stroom",
  "enabled": true,
  "sslRequired": "none",
  "clientScopes": [
    {
      "name": "stroom-audiences",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience stroom-mcp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "stroom-mcp",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience stroom",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "stroom",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "stroom-mcp-vscode",
      "name": "Stroom MCP (VS Code)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://127.0.0.1:33418",
        "http://127.0.0.1:33418/*",
        "https://vscode.dev/redirect",
        "https://insiders.vscode.dev/redirect"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "stroom-audiences",
        "basic",
        "profile"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "analyst",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Analyst",
      "email": "analyst@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "analyst-dev",
          "temporary": false
        }
      ]
    }
  ]
}
