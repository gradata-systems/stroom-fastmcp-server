STROOM_MCP_STROOM_URL=https://stroom.example.com
# Stroom calls use the caller's own token, whose aud must include this as well as the MCP audience. With a
# provider that issues one audience per token (Entra ID, Okta), set it to STROOM_MCP_OIDC_AUDIENCE.
# STROOM_MCP_STROOM_AUDIENCE=stroom
# STROOM_MCP_STROOM_CA_CERTS=/etc/stroom-mcp/stroom-ca.crt

# Any OpenID Connect provider; the issuer exactly as in the tokens' iss claim.
STROOM_MCP_OIDC_ISSUER_URL=https://keycloak.example.com/realms/stroom
STROOM_MCP_OIDC_AUDIENCE=stroom-mcp
STROOM_MCP_PUBLIC_BASE_URL=https://stroom-mcp.example.com
# STROOM_MCP_OIDC_JWKS_URI=            # default: jwks_uri from the issuer's discovery document
# STROOM_MCP_OIDC_REQUIRED_SCOPES=openid
# STROOM_MCP_OIDC_CA_CERTS=/etc/stroom-mcp/idp-ca.crt

# TLS is required: a certificate, or a proxy in front that terminates TLS.
STROOM_MCP_TLS_CERTFILE=/etc/stroom-mcp/tls.crt
STROOM_MCP_TLS_KEYFILE=/etc/stroom-mcp/tls.key
# STROOM_MCP_TLS_TERMINATED_UPSTREAM=true

# STROOM_MCP_WORKSPACE_FOLDER=MCP Workspace
# STROOM_MCP_EVENT_LOGGING_VERSION=3.5.2
# STROOM_MCP_AUDIT_LOG_FILE=/var/log/stroom-mcp/audit.jsonl
# Several replicas: shared keys for form state, comma-separated, each at least 32 characters.
# STROOM_MCP_REQUEST_STATE_KEYS=
